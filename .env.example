MONGODB_URI=mongodb://localhost:27017/alpha
PORT=5000
CLIENT_PORT=5173
CLIENT_ORIGIN=http://localhost:5173
CLIENT_PUBLIC_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
# Public IDs only; Vite exposes VITE_ variables to the browser bundle.
VITE_PUBLIC_API_URL=http://localhost:5000
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=
# Configure a random secret of at least 32 characters in production.
AUTH_TOKEN_SECRET=
# First API startup creates this admin only while the staff collection is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Razorpay test-mode credentials; never expose the key secret or webhook secret to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST invoice and locally mocked courier webhook settings; keep webhook secrets server-side.
COMPANY_NAME=
COMPANY_GSTIN=
COMPANY_STATE=
COMPANY_ADDRESS=
HSN_CODE=
GST_RATE=
COURIER_MODE=
COURIER_WEBHOOK_SECRET=
# Optional OTP SMS delivery. Keep these server-side; do not use VITE_ prefixes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Post-purchase email via Resend. Use an address verified with your Resend account.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Optional order-update channel: mock, sms (Twilio), or whatsapp (Meta template).
POST_PURCHASE_MESSAGE_CHANNEL=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=v22.0
